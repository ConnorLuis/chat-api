# Copy this file to .env and fill in secrets.
# The application reads environment variables directly and does not
# automatically load .env.
# Bash / WSL:
#   set -a && source .env && set +a

# Provider defaults
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_TIMEOUT_S=60

# Optional OpenAI / OpenAI-compatible provider
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=
OPENAI_TIMEOUT_S=60
OPENAI_COMPAT_DEFAULT_PROVIDER=mock

# Provider resilience
# Maximum attempts includes the initial call.
PROVIDER_RETRY_MAX_ATTEMPTS=2
PROVIDER_RETRY_BASE_DELAY_MS=100
PROVIDER_RETRY_MAX_DELAY_MS=1000

# Fallback is opt-in. The fallback model is independent of the
# request model used by the primary provider.
PROVIDER_FALLBACK_ENABLED=false
PROVIDER_FALLBACK_PROVIDER=
PROVIDER_FALLBACK_MODEL=

# Relational persistence
DATABASE_URL=sqlite:///./data/chat_api.db

# Service API key authentication
# Keep disabled until API_KEY_HASH_PEPPER and at least one API key are ready.
# Generate a pepper with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
API_AUTH_ENABLED=false
API_KEY_HASH_PEPPER=

# Request rate limiting
REQUEST_RATE_LIMIT_ENABLED=false
USER_RATE_LIMIT_REQUESTS=60
USER_RATE_LIMIT_WINDOW_SECONDS=60
IP_RATE_LIMIT_REQUESTS=120
IP_RATE_LIMIT_WINDOW_SECONDS=60

# Only enable this behind a trusted reverse proxy that overwrites forwarded
# client-IP headers.
RATE_LIMIT_TRUST_PROXY_HEADERS=false

# Caller-aware daily token quota
TOKEN_QUOTA_ENABLED=false
DAILY_TOKEN_QUOTA_TOKENS=100000

# Conversation context window
CONVERSATION_HISTORY_MAX_TURNS=10
CONVERSATION_CONTEXT_TOKEN_BUDGET=4096
CONVERSATION_HISTORY_FETCH_LIMIT=500

# Prompt, pricing, and run logs
PRICING_CATALOG_PATH=config/pricing_catalog.json
PROMPTS_DIR=prompts
RUN_LOG_PATH=runs/prompt_runs.jsonl

# Knowledge base and RAG
KB_DIR=kb
KB_CHROMA_DIR=kb/chroma
KB_COLLECTION=kb_chunks
KB_CHUNK_SIZE=800
KB_CHUNK_OVERLAP=120
KB_TOP_K=3
KB_CANDIDATE_K=50
KB_MAX_CONTEXT_CHARS=2000
DOCS_DIR=kb/docs
INDEX_FILE=kb/docs.jsonl
RAG_BACKEND=native

# mock is deterministic and suitable for tests/CI.
# For real embeddings, install requirements-embeddings.txt and use hf.
EMBEDDING_PROVIDER=mock
EMBEDDING_MODEL=maidalun1020/bce-embedding-base_v1
EMBEDDING_DIM=512
