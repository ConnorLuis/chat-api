# Tests and local-only development artifacts
tests/
*.egg-info/

# Runtime state must come from Docker volumes, never from the build context.
data/
runs/
*.db
*.sqlite3
*.log
kb/chroma/
kb/docs/
kb/docs.jsonl

# Generated benchmark/evaluation output and local backups
benchmarks/results/
eval/results/
eval/reports/
eval/results.jsonl
eval/summary.json
eval/kb_seed_manifest*.jsonl
eval/qa_q019.jsonl
eval/qa_probe_5.jsonl
